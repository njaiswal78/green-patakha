# Public URL the install is served on, without a trailing slash.
# Leave empty to use whatever host the request came in on.
APP_ORIGIN=

# Port the Node server listens on inside the container.
PORT=8080

# Where the SQLite counter lives (a Docker volume in compose).
DATA_DIR=/app/data

# Link shown in the footer and docs.
REPO_URL=https://github.com/njaiswal78/green-patakha
