{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "green-patakha",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/play",
      "/about",
      "/compare",
      "/docs",
      "/docs/*",
      "/api/*",
      "/mcp",
      "/llms.txt",
      "/llms-full.txt",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  // Set APP_ORIGIN to your domain (https://example.com) once it is attached.
  // Empty means "use the URL the request came in on".
  "workers_dev": true,
  // Routes rather than custom domains: the zone's proxied DNS records (left over from the registrar) stay,
  // and the Worker answers every request before it would reach them.
  "routes": [
    { "pattern": "diwali.click/*", "zone_name": "diwali.click" },
    { "pattern": "www.diwali.click/*", "zone_name": "diwali.click" }
  ],
  "vars": {
    "APP_ORIGIN": "https://diwali.click",
    "REPO_URL": "https://github.com/njaiswal78/green-patakha"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "green-patakha",
      "database_id": "f07e17ed-abf5-4c16-8ed9-aabca10ec9ed",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "FIRE_LIMIT",
      "namespace_id": "4801",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
